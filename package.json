{
	"name": "journeyhacks27",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": "^22.17.0 || >=24.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky && svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{css,html,json,md,yaml,yml}": "prettier --write"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^22.0.0",
		"eslint": "^10.0.0",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"prettier": "^3.8.0",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.8",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.0.12"
	}
}
